# Supabase Configuration (Leave blank to use local fallback storage)
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Backblaze B2 video storage (private bucket, served via presigned URLs)
# Endpoint is shown on the bucket card, e.g. s3.us-east-005.backblazeb2.com
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET=
B2_ENDPOINT=

# Admin Dashboard Password / Secret Key
ADMIN_SECRET_KEY=admin123